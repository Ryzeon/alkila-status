# Endpoint público que expone la salud de las dependencias privadas.
# Contrato esperado:
#   { "mongodb": { "status": "UP", "latencyMs": 12 },
#     "redis":   { "status": "UP", "latencyMs": 3 } }
# Sin esta variable, MongoDB y Redis se muestran como "sin datos".
ALKILA_DEPS_URL=

# Segundos entre refrescos automáticos en el cliente (default 30)
NEXT_PUBLIC_REFRESH_SECONDS=30
